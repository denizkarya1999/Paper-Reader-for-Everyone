{
  "name": "paper-reader-for-everyone",
  "version": "1.3.0",
  "description": "A Linux PDF reader with ChatGPT, flashcards, reading support, saved chats, sticky notes, themes, and a focus cat.",
  "author": {
    "name": "Deniz K. Acikbas"
  },
  "license": "MIT",
  "private": true,
  "main": "electron/main.cjs",
  "type": "module",
  "homepage": "https://github.com/denizkarya1999/Paper-Reader-for-Everyone",
  "repository": {
    "type": "git",
    "url": "https://github.com/denizkarya1999/Paper-Reader-for-Everyone.git"
  },
  "keywords": [
    "pdf-reader",
    "linux",
    "chatgpt",
    "openai",
    "sticky-notes",
    "electron",
    "research",
    "chat-history",
    "focus",
    "desktop-pet",
    "flashcards",
    "reading-support",
    "dark-mode"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "package:deb": "npm run build && electron-builder --linux deb --x64 --publish never",
    "package:dir": "npm run build && electron-builder --linux dir --x64 --publish never"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "lucide-react": "^1.31.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.624",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "electron": "^41.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.0",
    "fake-indexeddb": "^6.2.5",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "build": {
    "appId": "io.github.denizkarya1999.paperreader",
    "productName": "Paper Reader for Everyone",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "electron/*.cjs",
      "package.json",
      "!node_modules/**/*"
    ],
    "asar": true,
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Office",
      "executableName": "paper-reader-for-everyone",
      "icon": "assets/icon.png",
      "maintainer": "Deniz K. Acikbas",
      "synopsis": "Read PDFs, ask questions, and save sticky notes",
      "desktop": {
        "entry": {
          "Name": "Paper Reader for Everyone",
          "Comment": "Read PDFs with ChatGPT and keep notes in the margins",
          "Keywords": "PDF;Reader;ChatGPT;Notes;Research;"
        }
      },
      "syncDesktopName": true
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libsecret-1-0",
        "libasound2 | libasound2t64"
      ]
    },
    "artifactName": "paper-reader-for-everyone_${version}-2_${arch}.${ext}",
    "buildNumber": "2"
  },
  "desktopName": "paper-reader-for-everyone.desktop"
}
